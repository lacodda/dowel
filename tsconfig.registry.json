{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "types": ["node"],
    "paths": {
      "dowel-ui": ["./packages/dowel/src/index.ts"],
      "dowel-ui/marks": ["./packages/dowel/src/marks.ts"],
      // How a block names a primitive: the consumer's own alias, which
      // `shadcn add` rewrites to wherever that project keeps its components.
      "@/components/ui/*": ["./registry/ui/*"]
    }
  },
  "include": [
    "registry/**/*.tsx",
    "registry/**/*.ts",
    // The fictional world the stand, the blocks' pictures and the demo are
    // drawn from.
    "fixtures/**/*.ts",
    // The gates are code too, and a type error in a gate is a gate that does
    // not run. Includes the Playwright config and specs, which nothing else
    // typechecks.
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "playwright.config.ts",
    // The types of the functions the gates import from generators.
    "tools/build-llms.d.ts",
    "tools/build-history.d.ts",
    "tools/build-props.d.ts",
    "tools/release-notes.d.ts",
    "tools/breaking-changes.d.ts",
    "tools/mutation-floor.d.ts",
    "tools/mutation-shard.d.ts",
    "tools/marks-module.d.ts"
  ]
}
