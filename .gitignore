# Node
node_modules/
dist/
.vite/

# `prepack` copies the root README in beside the manifest at publish time.
# There is one README, and it lives at the root: this keeps the copy from
# being committed as a second one that then goes stale.
packages/*/README.md

# The agent briefing dowel *ships*, as a registry item a consumer installs.
#
# A global ignore rule keeps AI-assistant files out of every repository, and it
# is right - but here `AGENTS.md` is a product, not an artefact of working on
# one. Without this line `git add -A` skips it silently, the registry item
# builds from a file only the author has, and CI is the first thing to notice.
!registry/files/AGENTS.md

# Docs site output is built in CI only
docs/dist/
docs/.astro/

# Environment
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# Editors
.idea/
.vscode/
!.vscode/extensions.json

# Playwright's own output. The baselines under tests/visual are committed on
# purpose - they are the gate - but reports and failure diffs are not.
/test-results/
/playwright-report/
/blob-report/
