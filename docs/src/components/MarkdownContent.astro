---
/*
 * Starlight's markdown column, with the history of the page's item at its
 * foot. An override rather than a line in each page: a hundred and twenty
 * pages each remembering to draw it is a hundred and twenty chances to
 * forget, and the day the list of pages grows is the day one does.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro'
import History from './History.astro'
import { itemOfPage } from '../lib/history'

const item = itemOfPage(Astro.locals.starlightRoute.id)
---

<Default>
  <slot />
  {item && <History name={item.name} dir={item.dir} />}
</Default>
