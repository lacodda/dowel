---
/*
 * A pointer to the live stand.
 *
 * The documentation explains; the stand shows. They were the same thing for
 * one version and it went badly: an Astro slot renders once, so the second
 * half of a two-theme layout came out empty, and the components inside it had
 * the browser's own button styling because a documentation site cannot load a
 * preflight without flattening its own chrome.
 *
 * So the stand is its own application now - real theme, real reset, a switch
 * for the theme and for the accent of any product of the line - and this is
 * the door to it.
 */
interface Props {
  /** The component's section on the stand. */
  component: string
  /** What the reader will see there. */
  caption?: string
}

const { component, caption } = Astro.props
const href = `/dowel/stand/#${component}`
---

<a class="stand-link" href={href}>
  <span class="stand-link-body">
    <strong>See it live</strong>
    {caption && <span class="stand-link-caption">{caption}</span>}
  </span>
  <span class="stand-link-arrow" aria-hidden>→</span>
</a>

<style>
  .stand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .stand-link:hover {
    border-color: var(--sl-color-accent);
  }

  .stand-link-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stand-link-caption {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
  }

  .stand-link-arrow {
    margin-left: auto;
    color: var(--sl-color-accent);
  }
</style>
