---
/*
 * What each component of this item takes, read from its TypeScript.
 *
 * Drawn by the MarkdownContent override on every component and block page, so
 * no page keeps a table of its own: a hand-written table is a second copy of
 * the types, and it drifted from them more than once. A prop listed here is
 * one the item's file declares or gives a default; what the props type takes
 * from Base UI, the DOM or another component is named as a whole, with the
 * place it is documented.
 */
import { componentsOf, sourceHref, type Source } from '../lib/props'

interface Props {
  name: string
  dir: 'ui' | 'blocks'
}

const { name, dir } = Astro.props
const components = componentsOf(name)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

/** A doc comment's inline code, as code; everything else as text. */
function pieces(text: string): { code: boolean; text: string }[] {
  return text.split(/(`[^`]+`)/).filter(Boolean).map((piece) =>
    piece.startsWith('`') && piece.endsWith('`') ? { code: true, text: piece.slice(1, -1) } : { code: false, text: piece },
  )
}

/** A union, split where a line may break: between its members, never inside
 * one - `inline-start` broken after its hyphen reads as two choices. */
function typeParts(type: string): string[] {
  const parts: string[] = []
  let depth = 0
  let start = 0
  for (let index = 0; index < type.length; index += 1) {
    const char = type[index]!
    if ('([{<'.includes(char)) depth += 1
    else if (')]}>'.includes(char) && type[index - 1] !== '=') depth -= 1
    else if (char === '|' && depth === 0) {
      parts.push(type.slice(start, index).trim())
      start = index + 1
    }
  }
  parts.push(type.slice(start).trim())
  return parts
}

function sourceName(source: Source): string {
  if (source.kind === 'base-ui') return source.part ?? 'Base UI'
  if (source.kind === 'dowel') return source.name ?? source.type ?? source.item ?? ''
  return source.type ?? ''
}

function sourceOwner(source: Source): string {
  if (source.kind === 'base-ui') return "Base UI's"
  if (source.kind === 'react') return "React's"
  if (source.kind === 'dowel') return "dowel's"
  return ''
}
---

{
  components.length > 0 && (
    <section class="props">
      <h2 id="props">Props</h2>
      <p class="props-lede">
        Read from the types in <code>{`${dir}/${name}.tsx`}</code>, the file a product copies - so the description of
        each prop is also what an editor shows over it there.
      </p>
      {components.map((component) => (
        <div class="props-component">
          {components.length > 1 && (
            <h3 id={`props-${component.name.toLowerCase()}`}>
              <code>{component.name}</code>
            </h3>
          )}
          {component.description && (
            <p>
              {pieces(component.description).map((piece) => (piece.code ? <code>{piece.text}</code> : piece.text))}
            </p>
          )}
          {component.is && (
            <p class="props-is">
              {sourceOwner(component.is)} <code>{sourceName(component.is)}</code>, unchanged under dowel's name
              {sourceHref(component.is, base) && (
                <>
                  {' '}- its props are on <a href={sourceHref(component.is, base)}>its own page</a>
                </>
              )}
              .
            </p>
          )}
          {component.props && component.props.length > 0 && (
            <table>
              <thead>
                <tr>
                  <th>Prop</th>
                  <th>Type</th>
                  <th>Default</th>
                  <th />
                </tr>
              </thead>
              <tbody>
                {component.props.map((prop) => (
                  <tr>
                    <td>
                      <code>{prop.name}</code>
                      {prop.required && <span class="props-required">required</span>}
                      {prop.requiredWith && (
                        <span class="props-required">
                          with{' '}
                          {prop.requiredWith.map((other, index) => (
                            <>
                              {index > 0 && ', '}
                              <code>{other}</code>
                            </>
                          ))}
                        </span>
                      )}
                    </td>
                    <td class="props-type">
                      {typeParts(prop.type).map((part, index) => (
                        <>
                          {index > 0 && ' '}
                          <code class={part.length > 24 ? 'props-long' : undefined}>
                            {index > 0 ? `| ${part}` : part}
                          </code>
                        </>
                      ))}
                    </td>
                    <td>{prop.default !== undefined && <code>{prop.default}</code>}</td>
                    <td>
                      {prop.description &&
                        pieces(prop.description).map((piece) => (piece.code ? <code>{piece.text}</code> : piece.text))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {component.inherits && component.inherits.length > 0 && (
            <p class="props-inherits">
              {component.props && component.props.length > 0 ? 'And every' : 'Every'} prop of{' '}
              {component.inherits.map((source, index) => (
                <>
                  {index > 0 && (index === component.inherits!.length - 1 ? ' and ' : ', ')}
                  {sourceOwner(source)}{' '}
                  {sourceHref(source, base) ? (
                    <a href={sourceHref(source, base)}>
                      <code>{sourceName(source)}</code>
                    </a>
                  ) : (
                    <code>{sourceName(source)}</code>
                  )}
                  {source.omits && source.omits.length > 0 && (
                    <>
                      {' '}
                      except{' '}
                      {source.omits.map((omitted, at) => (
                        <>
                          {at > 0 && ', '}
                          <code>{omitted}</code>
                        </>
                      ))}
                    </>
                  )}
                </>
              ))}
              , passed on.
            </p>
          )}
          {!component.is && (component.props ?? []).length === 0 && (component.inherits ?? []).length === 0 && (
            <p class="props-inherits">Takes no props.</p>
          )}
        </div>
      ))}
    </section>
  )
}

<style>
  .props-lede,
  .props-inherits,
  .props-is {
    color: var(--sl-color-gray-2);
  }

  .props-required {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }

  .props h3 code {
    font-size: var(--sl-text-lg);
  }

  /* Fixed columns, so a long type wraps inside its own rather than pushing
   * the descriptions off the side of the page. */
  .props table {
    display: table;
    table-layout: fixed;
    width: 100%;
  }

  .props th:nth-child(1) {
    width: 24%;
  }

  .props th:nth-child(2) {
    width: 30%;
  }

  .props th:nth-child(3) {
    width: 12%;
  }

  .props td code {
    overflow-wrap: anywhere;
  }

  /* Each short member of a union stays whole - `inline-start` broken at its
   * hyphen reads as two choices - and the line breaks between members. A
   * long one, a generic with a union inside, may break where it has to. */
  .props-type code:not(.props-long) {
    white-space: nowrap;
  }
</style>
