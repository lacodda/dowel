---
/*
 * Every item the registry serves, searchable.
 *
 * The site's own search finds pages by their words. This finds items by what
 * they are: a name, what the item says it is for, the components it exports
 * and the props those take - so "which one takes `onRetry`" has an answer, and
 * "dialog" finds the confirm dialog and the drawer as well as Dialog. Read at
 * build time from the catalogue the registry serves and from the props read
 * out of the types; nothing here is written by hand.
 */
import registry from '../../public/r/registry.json'
import props from '../../../registry/props.json'

type Item = {
  name: string
  type: string
  title?: string
  description?: string
  registryDependencies?: string[]
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const site = 'https://lacodda.github.io/dowel'
const components = props as Record<string, { dir: string; components: { name: string; props?: { name: string }[] }[] }>

const KINDS: Record<string, string> = {
  'registry:ui': 'component',
  'registry:block': 'block',
  'registry:style': 'set',
}

/** The first sentence: a line in a list, not the item's whole case for itself. */
const firstSentence = (text = '') => text.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? text

const entries = (registry.items as Item[])
  .filter((item) => item.type in KINDS)
  .map((item) => {
    const exported = components[item.name]?.components ?? []
    const page =
      item.type === 'registry:ui'
        ? `${base}/components/${item.name}/`
        : item.type === 'registry:block'
          ? `${base}/blocks/${item.name}/`
          : null
    return {
      name: item.name,
      kind: KINDS[item.type]!,
      title: item.title ?? item.name,
      summary: firstSentence(item.description),
      page,
      install: `npx shadcn@latest add ${site}/r/${item.name}.json`,
      exports: exported.map((component) => component.name),
      props: [...new Set(exported.flatMap((component) => (component.props ?? []).map((prop) => prop.name)))].sort(),
      uses: (item.registryDependencies ?? []).map((url) => url.replace(/^.*\/r\//, '').replace(/\.json$/, '')),
    }
  })
  .sort((a, b) => a.name.localeCompare(b.name))
---

<div class="registry-search not-content">
  <label for="registry-query">Search the registry</label>
  <input
    id="registry-query"
    type="search"
    placeholder="A name, a word, a prop - onRetry, picker, toast"
    autocomplete="off"
    spellcheck="false"
  />
  <p class="registry-count" aria-live="polite">{entries.length} items</p>
  <ul class="registry-list">
    {
      entries.map((entry) => (
        <li
          data-name={entry.name}
          data-text={[entry.name, entry.title, entry.summary, ...entry.exports, ...entry.uses].join(' ').toLowerCase()}
          data-props={entry.props.join(' ')}
        >
          <div class="registry-head">
            {entry.page ? (
              <a href={entry.page}>
                <strong>{entry.title}</strong>
              </a>
            ) : (
              <strong>{entry.title}</strong>
            )}
            <span class="registry-kind">{entry.kind}</span>
          </div>
          <p>{entry.summary}</p>
          {entry.exports.length > 1 && (
            <p class="registry-exports">
              {entry.exports.map((name) => (
                <code>{name}</code>
              ))}
            </p>
          )}
          <p class="registry-match" hidden />
          <code class="registry-install">{entry.install}</code>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>('#registry-query')!
  const count = document.querySelector<HTMLElement>('.registry-count')!
  const rows = [...document.querySelectorAll<HTMLLIElement>('.registry-list > li')]
  const list = document.querySelector<HTMLUListElement>('.registry-list')!

  /** Every word has to be found somewhere in the item: its name, title,
   * summary, exports and what it builds on - or as the start of a prop name,
   * which is said under the item so the reader sees why it matched. */
  function filter() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean)
    let shown = 0
    const ranked: [number, HTMLLIElement][] = []
    for (const row of rows) {
      const text = row.dataset.text ?? ''
      const props = (row.dataset.props ?? '').split(' ').filter(Boolean)
      const matched: string[] = []
      const found = words.every((word) => {
        if (text.includes(word)) return true
        const prop = props.find((name) => name.toLowerCase().startsWith(word))
        if (prop) matched.push(prop)
        return prop !== undefined
      })
      row.hidden = !found
      const note = row.querySelector<HTMLElement>('.registry-match')!
      note.hidden = matched.length === 0
      note.replaceChildren(
        ...(matched.length ? ['Takes '] : []),
        ...matched.flatMap((name, index) => {
          const code = document.createElement('code')
          code.textContent = name
          return index > 0 ? [', ', code] : [code]
        }),
      )
      if (found) {
        shown += 1
        // A name that starts with the query first, then one that holds it.
        const name = row.dataset.name ?? ''
        const query = words.join('-')
        ranked.push([name.startsWith(query) ? 0 : name.includes(query) ? 1 : 2, row])
      }
    }
    ranked.sort((a, b) => a[0] - b[0] || (a[1].dataset.name ?? '').localeCompare(b[1].dataset.name ?? ''))
    for (const [, row] of ranked) list.append(row)
    count.textContent = words.length === 0 ? `${rows.length} items` : `${shown} of ${rows.length} items`
  }

  input.addEventListener('input', filter)
  // A link to the page with `?q=` opens it already searched.
  const query = new URLSearchParams(location.search).get('q')
  if (query) {
    input.value = query
    filter()
  }
</script>

<style>
  .registry-search label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .registry-search input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }

  .registry-search input:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .registry-count {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin: 0.5rem 0 1rem;
  }

  .registry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .registry-list > li {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 0.75rem 0;
  }

  .registry-list > li[hidden] {
    display: none;
  }

  .registry-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .registry-kind {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .registry-list p {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-2);
  }

  .registry-exports {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-size: var(--sl-text-xs);
  }

  .registry-match {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-accent-high);
  }

  .registry-install {
    display: block;
    margin-top: 0.375rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
</style>
