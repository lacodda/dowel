          ".tabular-nums"
        ]
      }
    ]
  },
  "light": {
    "passes": [
      "aria-allowed-attr",
      "aria-conditional-attr",
      "aria-hidden-focus",
      "aria-prohibited-attr",
      "aria-valid-attr",
      "aria-valid-attr-value",
      "button-name",
      "color-contrast",
      "empty-heading",
      "form-field-multiple-labels",
      "label",
      "label-title-only",
      "link-name",
      "nested-interactive",
      "target-size"
    ],
    "incomplete": [],
