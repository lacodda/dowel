    },
    "link-name": {
      "help": "Links must have discernible text",
      "criteria": [
        "2.4.4",
        "4.1.2"
      ]
    },
    "table-duplicate-name": {
      "help": "Tables should not have the same summary and caption",
      "criteria": []
    },
    "target-size": {
      "help": "All touch targets must be 24px large, or leave sufficient space",
      "criteria": [
        "2.5.8"
      ]
    },
    "td-headers-attr": {
