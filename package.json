{
  "name": "dowel-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "lint": "pnpm --filter dowel-ui build && eslint . && pnpm -r --filter ./packages/* typecheck && tsc --project tsconfig.registry.json && tsc --project stand/tsconfig.json && tsc --project demo/tsconfig.json",
    "typecheck": "pnpm -r --filter ./packages/* typecheck && tsc --project tsconfig.registry.json && tsc --project stand/tsconfig.json && tsc --project demo/tsconfig.json",
    "test": "vitest run",
    "new-component": "node tools/new-component.mjs",
    "stand": "pnpm --filter dowel-stand dev",
    "stand:build": "pnpm --filter dowel-stand build",
    "demo": "pnpm --filter dowel-demo dev",
    "demo:build": "pnpm --filter dowel-demo build",
    "mutate": "stryker run",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
