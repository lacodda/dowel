{
  "name": "dowel-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "lint": "pnpm --filter dowel-ui build && eslint . && pnpm -r --filter ./packages/* typecheck && tsc --project tsconfig.registry.json && tsc --project stand/tsconfig.json",
    "typecheck": "pnpm -r --filter ./packages/* typecheck && tsc --project tsconfig.registry.json && tsc --project stand/tsconfig.json",
    "test": "vitest run",
    "new-component": "node tools/new-component.mjs",
    "stand": "pnpm --filter dowel-stand dev",
    "stand:build": "pnpm --filter dowel-stand build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
