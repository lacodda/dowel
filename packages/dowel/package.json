{
  "name": "dowel-ui",
  "version": "0.14.1",
  "description": "The lacodda line design system: theme tokens and React primitives, distributed as a shadcn-compatible registry.",
  "license": "MIT",
  "type": "module",
  "author": "Kirill Lakhtachev <lahtachev@gmail.com>",
  "homepage": "https://lacodda.github.io/dowel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacodda/dowel.git"
  },
  "bugs": {
    "url": "https://github.com/lacodda/dowel/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "tailwindcss",
    "shadcn",
    "registry",
    "eslint-plugin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "dowel": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./registry.json": "./dist/registry.json",
    "./accents/*.css": "./dist/accents/*.css"
  },
  "scripts": {
    "build": "tsc && node ../../tools/copy-theme.mjs && node ../../tools/build-tokens-json.mjs && node ../../tools/build-accents.mjs && node ../../tools/build-registry.mjs && node ../../tools/build-schema.mjs && node ../../tools/build-llms.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../tools/copy-readme.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "class-variance-authority": "^0.7.1",
    "eslint": "^10.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
